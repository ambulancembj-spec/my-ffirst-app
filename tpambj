<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>TPA Baabul Jannah - Taman Pendidikan Al-Qur'an</title>
  <link href="https://fonts.googleapis.com/css2?family=Amiri:wght@400;700&family=Poppins:wght@300;500;700&display=swap" rel="stylesheet">
  <style>
    * { margin:0; padding:0; box-sizing:border-box; }
    body {
      font-family: 'Poppins', sans-serif;
      background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
      color: #333;
      direction: ltr;
    }
    .container { max-width: 1200px; margin: 0 auto; padding: 0 20px; }

    /* Header */
    header {
      background: rgba(0,0,0,0.4);
      padding: 1rem 0;
      position: fixed;
      width: 100%;
      z-index: 100;
      backdrop-filter: blur(10px);
    }
    .logo {
      font-family: 'Amiri', serif;
      font-size: 28px;
      font-weight: 700;
      color: #fff;
      text-align: center;
    }

    /* Hero Section */
    .hero {
      height: 100vh;
      background: linear-gradient(rgba(0,0,0,0.5), rgba(0,0,0,0.5)), url('https://images.unsplash.com/photo-1509062522246-3755977927d7?ixlib=rb-4.0.3&auto=format&fit=crop&q=80') center/cover no-repeat;
      display: flex;
      align-items: center;
      text-align: center;
      color: white;
    }
    .hero h1 {
      font-family: 'Amiri', serif;
      font-size: 4.5rem;
      margin-bottom: 20px;
      text-shadow: 0 4px 10px rgba(0,0,0,0.6);
    }
    .hero p {
      font-size: 1.4rem;
      margin-bottom: 30px;
    }
    .btn {
      background: #f4c40f;
      color: #000;
      padding: 14px 40px;
      border-radius: 50px;
      font-weight: bold;
      font-size: 1.2rem;
      text-decoration: none;
      display: inline-block;
      box-shadow: 0 8px 20px rgba(244,196,15,0.4);
      transition: all 0.3s;
    }
    .btn:hover { transform: translateY(-5px); box-shadow: 0 15px 30px rgba(244,196,15,0.6); }

    /* Sections */
    section {
      padding: 80px 0;
      background: white;
    }
    .section-title {
      font-family: 'Amiri', serif;
      font-size: 3rem;
      text-align: center;
      margin-bottom: 50px;
      color: #2c3e50;
    }
    .features {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      gap: 30px;
      text-align: center;
    }
    .feature {
      background: #f8f9fa;
      padding: 40px 20px;
      border-radius: 20px;
      box-shadow: 0 10px 30px rgba(0,0,0,0.1);
    }
    .feature i { font-size: 3.5rem; color: #667eea; margin-bottom: 20px; }
    .feature h3 { font-size: 1.6rem; margin-bottom: 15px; color: #2c3e50; }

    /* Program */
    .program-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
      gap: 30px;
    }
    .program-card {
      background: linear-gradient(135deg, #667eea, #764ba2);
      color: white;
      padding: 30px;
      border-radius: 20px;
      text-align: center;
    }
    .program-card h3 { font-size: 1.8rem; margin-bottom: 15px; }

    /* Footer */
    footer {
      background: #2c3e50;
      color: white;
      text-align: center;
      padding: 50px 20px;
    }
    footer h2 { font-family: 'Amiri', serif; font-size: 2.5rem; margin-bottom: 20px; }
    .social { margin: 20px 0; }
    .social a { color: #f4c40f; font-size: 2rem; margin: 0 15px; }
  </style>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css"/>
</head>
<body>

  <header>
    <div class="container">
      <div class="logo">TPA Baabul Jannah</div>
    </div>
  </header>

  <section class="hero">
    <div class="container">
      <h1>TPA BAABUL JANNAH</h1>
      <p>Taman Pendidikan Al-Qur'an • Membentuk Generasi Penghafal Qur'an</p>
      <a href="https://wa.me/628xxxxxxx" class="btn" target="_blank">
        <i class="fab fa-whatsapp"></i> Daftar Sekarang via WhatsApp
      </a>
    </div>
  </section>

  <section>
    <div class="container">
      <h2 class="section-title">Mengapa Memilih Kami?</h2>
      <div class="features">
        <div class="feature">
          <i class="fas fa-mosque"></i>
          <h3>Pengajar Bersertifikat</h3>
          <p>Ustadz & ustadzah lulusan pondok pesantren tahfidz</p>
        </div>
        <div class="feature">
          <i class="fas fa-quran"></i>
          <h3>Metode Tahfidz Modern</h3>
          <p>Sistem pengulangan berbasis aplikasi + muroja'ah intensif</p>
        </div>
        <div class="feature">
          <i class="fas fa-clock"></i>
          <h3>Jadwal Fleksibel</h3>
          <p>Sore hari (Setelah sekolah) & akhir pekan</p>
        </div>
      </div>
    </div>
  </section>

  <section style="background:#f8f9fa;">
    <div class="container">
      <h2 class="section-title">Program Unggulan</h2>
      <div class="program-grid">
        <div class="program-card">
          <h3>Tahfidz 30 Juz</h3>
          <p>Target 3–5 tahun khatam + sanad</p>
        </div>
        <div class="program-card">
          <h3>Tahsin & Tajwid</h3>
          <p>Perbaikan bacaan untuk semua umur</p>
        </div>
        <div class="program-card">
          <h3>Kelas Anak & Dewasa</h3>
          <p>Usia 5 tahun hingga lansia</p>
        </div>
      </div>
    </div>
  </section>

  <footer>
    <h2>TPA Baabul Jannah</h2>
    <p>Jl. Contoh Alamat No. 123, Kelurahan, Kecamatan, Kota/Kabupaten</p>
    <p><i class="fas fa-phone"></i> 08xx-xxxx-xxxx | <i class="fas fa-envelope"></i> info@tpabaabuljannah.com</p>
    <div class="social">
      <a href="#"><i class="fab fa-instagram"></i></a>
      <a href="#"><i class="fab fa-facebook"></i></a>
      <a href="#"><i class="fab fa-youtube"></i></a>
    </div>
    <p>&copy; 2025 TPA Baabul Jannah – Membentuk Generasi Qur'ani</p>
  </footer>

</body>
</html>
